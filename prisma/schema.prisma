// Digital Cards — schema. Postgres-backed (Vercel/Neon in production).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum ContactSource {
  AI_SCAN
  CARD_INBOUND
}

enum CrmProvider {
  GOOGLE_CONTACTS
}

model Organization {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  logoUrl        String?
  primaryColor   String   @default("#111827")
  secondaryColor String   @default("#34d399")
  headingFont    String   @default("Poppins")
  bodyFont       String   @default("Poppins")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships     Membership[]
  cards           Card[]
  scannedContacts ScannedContact[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships     Membership[]
  cards           Card[]
  scannedContacts ScannedContact[]
  crmConnections  CrmConnection[]
  accounts        Account[]
  sessions        Session[]
}

// Auth.js Prisma adapter tables — required for database sessions (Google
// sign-in). See https://authjs.dev/getting-started/adapters/prisma
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id     String @id @default(cuid())
  role   Role   @default(MEMBER)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
}

model Card {
  id        String  @id @default(cuid())
  slug      String
  jobTitle  String?
  phone     String?
  whatsapp  String?
  email     String?
  website   String?
  socialLinks String @default("{}") // JSON string: SQLite has no native Json type in this setup
  photoUrl  String?

  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, slug])
  @@unique([orgId, ownerUserId])
}

model ScannedContact {
  id           String        @id @default(cuid())
  name         String?
  jobTitle     String?
  company      String?
  phone        String?
  email        String?
  rawImageUrl  String?
  source       ContactSource @default(AI_SCAN)
  syncedToCrm  Boolean       @default(false)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  scannedByUserId String
  scannedBy       User   @relation(fields: [scannedByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model CrmConnection {
  id           String      @id @default(cuid())
  provider     CrmProvider
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
}
