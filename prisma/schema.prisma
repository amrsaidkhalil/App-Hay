// Digital Cards — schema. Postgres-backed (Vercel/Neon in production).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum ContactSource {
  AI_SCAN
  CARD_INBOUND
}

enum CrmProvider {
  GOOGLE_CONTACTS
}

model Organization {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  logoUrl String?

  // How the logo sits inside the round avatar. Uploaded logos are usually wide
  // rectangles, so without these a logo just letterboxes into a tiny strip.
  // scale is a multiplier; offsets are percentages of the frame.
  logoScale   Float @default(1)
  logoOffsetX Float @default(0)
  logoOffsetY Float @default(0)

  // Card palette: primary is the solid card background, textColor is what's
  // printed on it, secondaryColor is the accent (logo ring, QR modules).
  primaryColor   String @default("#111827")
  textColor      String @default("#ffffff")
  secondaryColor String @default("#34d399")

  headingFont String @default("Poppins")
  bodyFont    String @default("Poppins")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships     Membership[]
  cards           Card[]
  scannedContacts ScannedContact[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships     Membership[]
  cards           Card[]
  scannedContacts ScannedContact[]
  crmConnections  CrmConnection[]
  accounts        Account[]
  sessions        Session[]
}

// Auth.js Prisma adapter tables — required for database sessions (Google
// sign-in). See https://authjs.dev/getting-started/adapters/prisma
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id   String @id @default(cuid())
  role Role   @default(MEMBER)
  // Superseded by `order` (drag-reorder replaced the single "primary" star).
  // Left in place rather than dropped, since removing a populated column
  // needs an explicit accept-data-loss push — not worth doing for one bool.
  isPrimary Boolean @default(false)
  // Position in this user's own card list — lower shows first. Drag-reordered
  // in Settings; ties (e.g. two brands still at the default 0) fall back to
  // alphabetical so a never-reordered list stays predictable.
  order Int @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
}

model Card {
  id        String  @id @default(cuid())
  slug      String
  jobTitle  String?
  phone     String?
  whatsapp  String?
  email     String?
  website   String?
  socialLinks String @default("{}") // JSON string: SQLite has no native Json type in this setup
  photoUrl  String?

  // Same framing controls as the org logo, for the card's own photo.
  photoScale   Float @default(1)
  photoOffsetX Float @default(0)
  photoOffsetY Float @default(0)

  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  previousSlugs CardSlugHistory[]

  @@unique([orgId, slug])
  @@unique([orgId, ownerUserId])
}

/**
 * Public URLs end up printed on QR codes and pasted into signatures, so a
 * renamed card must not strand them. Every previous slug is kept here and
 * redirected to the card's current URL.
 */
model CardSlugHistory {
  id   String @id @default(cuid())
  slug String

  orgId String

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([orgId, slug])
}

model ScannedContact {
  id           String        @id @default(cuid())
  name         String?
  jobTitle     String?
  company      String?
  phone        String?
  email        String?
  rawImageUrl  String?
  source       ContactSource @default(AI_SCAN)
  syncedToCrm  Boolean       @default(false)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  scannedByUserId String
  scannedBy       User   @relation(fields: [scannedByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model CrmConnection {
  id           String      @id @default(cuid())
  provider     CrmProvider
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
}
